NASTRAN
SOL 101               $ 线性静力分析
CEND
TITLE = 3-Bar Truss Model
SUBCASE 1
  LOAD = 100          $ 引用载荷集ID=100
  SPC = 200           $ 引用约束集ID=200
  DISPLACEMENT = ALL  $ 输出所有节点位移
  STRESS = ALL        $ 输出所有单元应力
BEGIN BULK

$---------- 节点定义 ----------
$ 格式: GRID, ID, , X, Y, Z
GRID, 1, , 0.0, 0.0, 0.0     $ 节点1 (原点)
GRID, 2, , 100.0, 0.0, 0.0    $ 节点2 (X方向100单位)
GRID, 3, , 200.0, 0.0, 0.0    $ 节点3 (X方向200单位)
GRID, 4, , 300.0, 0.0, 0.0    $ 节点4 (X方向300单位)

$---------- 单元定义 ----------
$ 格式: CROD, ID, PID, G1, G2
CROD, 10, 1, 1, 2     $ 单元10连接节点1-2
CROD, 20, 1, 2, 3     $ 单元20连接节点2-3
CROD, 30, 1, 3, 4     $ 单元30连接节点3-4

$---------- 材料定义 ----------
$ 格式: MAT1, ID, E, NU, RHO
MAT1, 1, 2.1E5, 0.3  $ 材料1: 弹性模量210GPa, 泊松比0.3

$---------- 杆单元属性 ----------
$ 格式: PROD, ID, MID, A (面积)
PROD, 1, 1, 50.0      $ 属性1: 关联材料1，截面积50.0

$---------- 约束 ----------
$ 格式: SPC1, ID, DOF, GRID
SPC1, 200, 123456, 1  $ 节点1固定所有自由度 (1-6方向)

$---------- 载荷 ----------
$ 格式: FORCE, ID, GRID, F, FX, FY, FZ
FORCE, 100, 4, 1000.0, 1.0, 0.0, 0.0  $ 节点4施加X方向1000N力

ENDDATA