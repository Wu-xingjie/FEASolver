$ 示例：两杆结构静力分析
ID TEST, TWO-BAR TRUSS
SOL 101              $ 线性静力分析
TIME 10
CEND
TITLE = AXIAL LOAD ON TWO-BAR STRUCTURE
SUBCASE 1
  LOAD = 100         $ 引用载荷集100
  SPC = 1            $ 引用约束集1
  DISPLACEMENT = ALL $ 输出所有位移
  STRESS = ALL       $ 输出所有应力
BEGIN BULK

$ 定义节点
GRID    1       0.0     0.0     0.0     $ 节点A (固定端)
GRID    2       1.0     0.0     0.0     $ 节点B (连接点)
GRID    3       2.0     0.0     0.0     $ 节点C (加载点)

$ 定义杆单元（CROD单元）
CROD    10      100     1       2       $ 单元AB，连接节点1-2
CROD    20      100     2       3       $ 单元BC，连接节点2-3

$ 定义杆单元属性（钢制圆形截面，半径0.01m）
PROD    100     200     0.00031416      $ PID=100, MID=200, Area=π*(0.01)^2

$ 定义材料（钢）
MAT1    200     2.0E11  0.3             $ E=200GPa, ν=0.3

$ 定义约束（A点全固定）
SPC1    1       123456  1               $ 约束节点1的所有自由度

$ 定义载荷（C点轴向力1000N）
FORCE   100     3       0       1000.0  1.0    0.0    0.0
LOAD    100     1.0     100     1.0     $ 组合载荷集

ENDDATA